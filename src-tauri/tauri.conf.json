{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LM2 Bicycle Trading",
  "version": "0.1.0",
  "identifier": "com.lm2.bicycle.trading",
  "build": {
    "frontendDist": "https://lm2bicycletrading.larable.dev",
    "devUrl": "https://lm2bicycletrading.larable.dev",
    "beforeDevCommand": "cmd /c echo skipping",
    "beforeBuildCommand": "cmd /c echo skipping"
  },
  "app": {
    "windows": [
      {
        "title": "LM2 Bicycle Trading",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/png/512x512.png",
      "icons/apple-touch-icon.png"
    ]
  }
}